<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true"></script>

    
    <title>Achievement Tracker</title>

</head>
<body>
    <nav class="navbar navbar-expand-lg shadow-sm custom-navbar" id = "mainNavbar">
        <div class="container-fluid px-4">
            <!-- Geçici Logomuz -->
            <a class="navbar-brand fw-bold text-uppercase tracking-wider" href="/">
                <i class="bi bi-trophy-fill text-warning me-2"></i>Achievement Tracker
            </a>

            <!-- Mobilde küçülme butonu (Hamburger menü) -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navnar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-2">
                    <li class="nav-item">
                        <!-- Home tuşuna basınca anasayfaya (Index) atması için asp-controller ve action eklendi -->
                        <a class="nav-link active" aria-current="page" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door-fill me-1"></i> @Localizer["NavHome"]
                        </a>
                    </li>
                    <!-- Tamamlanan Oyunlar Sayfası Linki -->
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" asp-controller="Home" asp-action="CompletedGames">
                            <i class="bi bi-trophy-fill me-1"></i> @Localizer["NavCompletedGames"]
                        </a>
                    </li>
                    <!-- %100 Sayfası Linki -->
                    <li class="nav-item">
                        <a class="nav-link text-light fw-semibold" asp-controller="Home" asp-action="HundredList">
                            <i class="bi bi-star-fill me-1"></i> @Localizer["NavList100"]
                        </a>
                    </li>
                </ul>
                <!-- SAĞ KISIM: Arama Çubuğu ve Ayarlar Menüsü (ms-auto ile sağa yaslı) -->
                <div class="d-flex ms-auto align-items-center gap-3">

                    <!-- 1. Arama Çubuğu -->
                    <div class="input-group search-bar-custom" style="width: 250px;">
                        <input class="form-control bg-dark text-light border-warning" type="search" id="globalSearchInput" placeholder="@Localizer["Searchbar"]" aria-label="Search" autocomplete="off">
                        <button class="btn btn-outline-warning" type="button" id="globalSearchBtn">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    <!-- 2. Ayarlar Dropdown -->
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <!-- data-bs-auto-close="outside": İçerideki dil menüsüne tıklayınca dropdown'ın hemen kapanmasını engeller -->
                            <a class="nav-link dropdown-toggle text-light" href="#" id="settingsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
                                <i class="bi bi-gear-fill me-1"></i> @Localizer["NavSettings"]
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow" aria-labelledby="settingsDropdown" style="width: 220px;">

                                <!-- Tema Değiştirme -->
                                <li>
                                    <div class="dropdown-item d-flex justify-content-between align-items-center" style="cursor: pointer;" onclick="document.getElementById('themeSwitch').click(); event.stopPropagation();">
                                        <span><i class="bi bi-moon-stars-fill me-2"></i>@Localizer["Theme"]</span>
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox" id="themeSwitch">
                                        </div>
                                    </div>
                                </li>

                                <li><hr class="dropdown-divider border-secondary" /></li>

                                <!-- Dil Seçenekleri (Açılır/Kapanır Alt Menü) -->
                                <li>
                                    <!-- data-bs-toggle="collapse": Tıklanınca altındaki id="languageCollapse" div'ini açar -->
                                    <a class="dropdown-item d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#languageCollapse" role="button" aria-expanded="false" aria-controls="languageCollapse">
                                        <span><i class="bi bi-globe me-2"></i>@Localizer["Language"]</span>
                                        <i class="bi bi-chevron-down" style="font-size: 0.8rem;"></i>
                                    </a>

                                    <!-- Açılan Kısım -->
                                    <div class="collapse" id="languageCollapse">
                                        <!-- Görsel uyum için biraz iç boşluk (padding/margin) ve koyu arkaplan verildi -->
                                        <div class="bg-secondary bg-opacity-25 py-2 mx-2 rounded mt-1">
                                            <form asp-controller="Admin" asp-action="SetLanguage" method="post" class="mb-1">
                                                <input type="hidden" name="culture" value="tr-TR" />
                                                <!-- ps-4 ile yazıyı biraz daha sağdan başlattık ki alt eleman olduğu belli olsun -->
                                                <button type="submit" class="dropdown-item bg-transparent text-light ps-4">@Localizer["Turkish"]</button>
                                            </form>
                                            <form asp-controller="Admin" asp-action="SetLanguage" method="post">
                                                <input type="hidden" name="culture" value="en-US" />
                                                <button type="submit" class="dropdown-item bg-transparent text-light ps-4">@Localizer["English"]</button>
                                            </form>
                                        </div>
                                    </div>
                                </li>

                                <li><hr class="dropdown-divider border-secondary" /></li>

                                <!-- Oyun Ekleme Linki -->
                                <li>
                                    <a class="dropdown-item" href="/Admin/AddGame">
                                        <i class="bi bi-plus-circle me-2"></i>@Localizer["AddGame"]
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <hr />
    <footer class="footer text-muted mt-auto">
        <div class="container d-flex justify-content-between align-items-center">
            <!-- Sosyal medya ikonlarını sola aldık, biraz daha büyüttük (fs-5) -->
            <span class="fs-5">
                <a href="#" class="text-muted text-decoration-none me-3 hover-warning transition-color"><i class="bi bi-steam"></i></a>
                <a href="#" class="text-muted text-decoration-none hover-warning transition-color"><i class="bi bi-github"></i></a>
            </span>
            <!-- Telif hakkı yazısı -->
            <span class="small">&copy; 2026 - Achievement Tracker System</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- SweetAlert2 Kütüphanesi -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- 1. Ses Dosyasını HTML'e Ekle -->
    <audio id="trophyAudio" src="/sounds/trophy.mp3" preload="auto"></audio>

    <!-- 2. Tetikleyici JavaScript Mekanizması -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const epicCards = document.querySelectorAll('.game-card-epic');
            const trophySound = document.getElementById('trophyAudio');

            epicCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    // Sesi sadece karta İLK kez gelindiğinde çal
                    if (!this.dataset.soundPlayed) {
                        trophySound.volume = 0.3; // Ses seviyesi %30
                        trophySound.currentTime = 0;
                        trophySound.play().catch(e => console.log("Otomatik ses çalma tarayıcı tarafından engellendi."));

                        this.dataset.soundPlayed = 'true';
                    }
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>