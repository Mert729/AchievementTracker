@model AchievementTracker.Models.Game

@{
    ViewBag.Title = "Edit Game";
}

<div class="container mt-4 text-light">
    <h2 class="mb-4">@Localizer["EditGame"]</h2>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <!-- Hangi oyunun güncellendiğini anlamamız için gizli Id alanı -->
        @Html.HiddenFor(model => model.Id)

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.Name, @Localizer["GameName"].Value, new { @class = "form-label" })
            @Html.EditorFor(model => model.Name, new{ htmlAttributes = new{ @class = "form-control bg-dark text-light border-secondary"}})
            @Html.ValidationMessageFor(model => model.Name, "", new{ @class = "text-danger"})
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.IconFolderName, @Localizer["IconFolderName"].Value, new { @class = "form-label" })
            @Html.EditorFor(model => model.IconFolderName, new { htmlAttributes = new { @class = "form-control bg-dark text-light border-secondary" } })
            @Html.ValidationMessageFor(model => model.IconFolderName, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(model => model.Platform, @Localizer["Platform"].Value, new { @class = "form-label" })
            @Html.EditorFor(model => model.Platform, new { htmlAttributes = new { @class = "form-control bg-dark text-light border-secondary" } })
            @Html.ValidationMessageFor(model => model.Platform, "", new { @class = "text-danger" })
        </div>
        
        <div class="form-group mb-3">
            @Html.LabelFor(model => model.CoverImageUrl, @Localizer["CoverImageURL"].Value, new { @class = "form-label" })
            @Html.EditorFor(model => model.CoverImageUrl, new { htmlAttributes = new { @class = "form-control bg-dark text-light border-secondary" } })
            @Html.ValidationMessageFor(model => model.CoverImageUrl, "", new { @class = "text-danger" })
        </div>
        
        <div class="form-group mb-3">
            @Html.LabelFor(model => model.ReleaseDate, @Localizer["ReleaseDate"].Value, new { @class = "form-label" })
            @Html.EditorFor(model => model.ReleaseDate, new { htmlAttributes = new { @class = "form-control bg-dark text-light border-secondary" } })
            @Html.ValidationMessageFor(model => model.ReleaseDate, "", new { @class = "text-danger" })
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-warning px-4 fw-bold">@Localizer["SaveChanges"].Value</button>
            <a href="@Url.Action("Index", "Home")" class="btn btn-secondary px-3 ms-2">@Localizer["Cancel"].Value</a>
        </div>
    }
</div>