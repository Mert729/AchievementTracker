@model AchievementTracker.Models.Game

@{
    ViewData["Title"] = Model.Name + " - Guide";
}

<div class="container mt-4">
    <!-- Oyun Başlığı ve Kapağı -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-2">
            <img src="@Model.CoverImageUrl" class="img-fluid rounded shadow" alt="@Model.Name" />
        </div>
        <div class="dm-white col-md-10">
            <h2 class="fw-bold mb-0">@Model.Name</h2>
            <p class="mb-0 mt-1">@Localizer["Guide100"]</p>
        </div>

        <!-- Seni Doğrudan Başarımlara Geri Götürecek Kupa İkonlu Buton -->
        <!-- UX Dokunuşu: col-12 içine alındı, w-100 ve py-2 eklendi. Artık cılız bir çizgi değil, tok bir buton! -->
        <div class="dm-gold col-12 mt-4">
            <a asp-controller="Home" asp-action="Achievements" asp-route-id="@Model.Id" class="btn btn-outline-info w-100 py-2 fw-semibold">
                <i class="bi bi-trophy-fill me-1"></i> @Localizer["ViewAchievements"]
            </a>
        </div>
    </div>

    <hr class="border-secondary mb-4" />

    <!-- Başarımlar ve Rehber Çözümleri -->
    <div class="row">
        @foreach (var a in Model.Achievements)
        {
            <div class="col-12 mb-4">
                <!-- mb-3'ü mb-4 yaptık, başarımlar arası nefes alsın -->
                <!-- Sihrin Başladığı Yer: Yan yana dizilim (d-flex) -->
                <div class="d-flex">

                    <!-- Sol Taraf: Kupa Görseli -->
                    <div class="me-3 flex-shrink-0">
                        <img src="~/TrophyIcons/@(a.Game?.UrlName)/tier-@((int)a.TrophyTierId).png" alt="@a.Name" class="trophy-rectangular"/>
                    </div>

                    <!-- Sağ Taraf: Detaylar ve Çözüm Kutusu -->
                    <div class="flex-grow-1">
                        <h5 class="fw-bold mb-0 guide-achievement-title">@a.Name</h5>
                        <p class="text-secondary mb-2">@a.Description</p>

                        <!-- Burası ileride Spoiler Koruması ve Video eklenecek alan -->
                        <!-- Input görünümünü ezen özel class'ımızı ekledik -->
                        <div class="guide-solution-box shadow-sm mt-3">
                            <p class="mb-0 text-muted"><em>Guide solution will be placed here...</em></p>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>