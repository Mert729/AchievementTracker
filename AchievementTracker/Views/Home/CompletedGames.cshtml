@model IEnumerable<Game>
@{
    ViewData["Title"] = "Completed Games";
    ViewData["ShowCompletionDetails"] = true; // Şalteri Açtık!
}

<div class="container mt-4">
    <!-- Sayfa Başlığı ve Sayaç -->
    <div class="dm-gold d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-2">
        <h2 class="mb-0">
            <i class="bi bi-trophy-fill me-2"></i> @Localizer["NavCompletedGames"]
        </h2>
        <span class="dynamic-badge fs-6 px-3 py-2 rounded-pill">
            <i class="bi bi-controller me-1"></i> @Localizer["TotalGames", @Model.Count()]
        </span>
    </div>

    @if (!Model.Any())
    {
        <!-- KART YOKSA: Tamamen ortalanmış boş durum ekranı -->
        <div class="dm-white col-12 text-center mt-5 justify-content-center">
            <i class="bi bi-controller" style="font-size: 4rem;"></i>
            <h4 class="my-2">@Localizer["NoCompletedGames"]</h4>
            <p class="pb-2">@Localizer["GoCollectTrophies"]</p>
        </div>
    }
    else
    {
        <!-- KART VARSA: Döngünün DIŞINDA ana ızgara konteyneri -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 ultra-wide-4 g-4" id="gamesContainer">

            @foreach (var game in Model)
            {
                <!-- AMELİYAT BURADA: Yüzlerce satır kod yerine sadece Partial View çağırıyoruz -->
                <partial name="_GameCardPartial" model="game" />
            }

        </div>
    }
</div>